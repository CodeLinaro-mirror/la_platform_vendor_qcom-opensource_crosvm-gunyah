
rust_bindgen {
    name: "libuevent_ext_bindgen",
    wrapper_src: "rs_src/bindgen/uevent.h",
    crate_name: "uevent_ext_bindgen",
    source_stem: "bindings",
    header_libs: ["libcutils_headers"],
    bindgen_flags: [
        "--allowlist-function", "uevent_open_socket",
        "--allowlist-function", "uevent_kernel_multicast_recv",
    ],
    product_available: true,
}

rust_binary {
    name: "vendor.qti.qvirt-service-ext_rs",
    product_specific: true,
    srcs: [
        "rs_src/main.rs",
    ],
    vintf_fragments: ["vendor.qti.qvirt-service.xml"],
    init_rc: ["vendor.qti.qvirt-service-ext_rs.rc"],
    dylibs: [
        "liblogger",
        "liblog_rust",
        "libbinder_rs",
        "libnix",
        "libserde",
        "libserde_json",
        "liblibc",
        "librustutils",
        "vendor.qti.qvirt-V2-rust",
    ],
    rlibs: [
        "libuevent_ext_bindgen",
    ],
    shared_libs: [
        "libcutils",
    ],
    proc_macros: [
        "libserde_derive",
    ],
}